# Copy to .env and adjust as needed. Nothing here is a real secret.
# In Azure, these would be resolved from Azure Key Vault via Managed Identity
# instead of a plain .env file (see README > Security & Configuration).

# Overrides config/config.yaml's warehouse path if set; otherwise the default is used.
MORTGAGE_WAREHOUSE_PATH=data/processed/mortgage.duckdb

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# FastAPI service
API_HOST=0.0.0.0
API_PORT=8000
